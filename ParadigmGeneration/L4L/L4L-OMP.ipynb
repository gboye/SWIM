   "metadata": {},
   "outputs": [],
   "source": [
    "repL4L=\"/Users/gilles/sDrive/Recherche/Boye/HDR/Data/L4L/\"\n",
    "fL4L=\"L4L-complet.csv\"\n",
    "fL4L=\"L4L-paradigmes-head.csv\"\n",
    "#fL4L=\"L4L-paradigmes-tail.csv\"\n",
    "\n",
    "paradigmes=pd.read_csv(repL4L+fL4L,sep=\";\",encoding=\"utf8\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "2683ea7e-9932-4836-87ca-64805b545078",
